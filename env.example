# ══════════════════════════════════════════════
# VARIABLES DE ENTORNO - Tu Bot de Telegram
# ══════════════════════════════════════════════
# 
# INSTRUCCIONES:
# 1. Renombra este archivo a: .env
# 2. Rellena los valores (sin comillas)
# 3. Nunca subas este archivo a GitHub
# ══════════════════════════════════════════════

# 🤖 Token de tu bot (lo obtienes de @BotFather en Telegram)
TELEGRAM_TOKEN=aqui_va_tu_token_de_botfather

# 🧠 API Key de Anthropic (gratis en console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-aqui_va_tu_api_key

# 🔒 Tu ID de Telegram (opcional, para que solo tú uses el bot)
# Para saber tu ID: habla con @userinfobot en Telegram
# Déjalo vacío si quieres que cualquiera pueda usarlo
YOUR_TELEGRAM_ID=
